<% layout("listings/layouts/boilerplate") %>
<body>
    <br>
    <h3>Create A New Listing</h3>
    <br>

    <form action="/listings" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="Enter the title" type="text" class="form-control" required>
            <div class="valid-feedback">Title Looks Good!</div>
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">Description</label>
            <textarea name="listing[description]" placeholder="Enter description" class="form-control" required></textarea>
            <div class="invalid-feedback">Please Enter A Short Decription</div>
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">Image-Link</label>
            <input name="listing[image][url]" placeholder="Enter image/URL" class="form-control">
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">Price</label>
            <input name="listing[price]" placeholder="Enter price" type="text" class="form-control" required>
            <div class="invalid-feedback">Price should be valid</div>
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">Location</label>
            <input name="listing[location]" placeholder="Enter location" type="text" class="form-control" required>
            <div class="invalid-feedback">Location should be valid</div>
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">Country</label>
            <input name="listing[country]" placeholder="Enter country" type="text" class="form-control" required>
            <div class="invalid-feedback">Country should be valid</div>
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="bedrooms" class="form-label">Bedrooms</label>
                <input id="bedrooms" name="listing[bedrooms]" value="1" type="number" min="1" max="50" step="1" class="form-control" required>
            </div>
            <div class="mb-3 col-md-4">
                <label for="beds" class="form-label">Beds</label>
                <input id="beds" name="listing[beds]" value="1" type="number" min="1" max="50" step="1" class="form-control" required>
            </div>
            <div class="mb-3 col-md-4">
                <label for="bathrooms" class="form-label">Bathrooms</label>
                <input id="bathrooms" name="listing[bathrooms]" value="1" type="number" min="1" max="50" step="1" class="form-control" required>
            </div>
        </div>
        <div class="mb-3">
            <label for="amenities" class="form-label">Amenities (comma separated)</label>
            <input id="amenities" name="listing[amenities]" placeholder="e.g. Wifi, Kitchen, Pool, Parking" class="form-control">
        </div>
        <div class="mb-3">
            <label for="guests" class="form-label">Max guests</label>
            <input id="guests" name="listing[guests]" value="2" placeholder="Enter maximum guests" type="number" min="1" max="20" step="1" class="form-control" required>
            <div class="invalid-feedback">Enter a number between 1 and 20</div>
        </div>
        <br>
        <button class="btn btn-dark edit btn mt-3">Add</button>
        <br>


    </form>

 

</body>
<br>
